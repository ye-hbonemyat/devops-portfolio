---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
const services = [
  {
    title: 'Cloud Infrastructure Health Check',
    fit: 'For teams that want an experienced second opinion on their infrastructure.',
    focus: [
      'Cloud architecture and networking',
      'IAM, security and access',
      'Kubernetes and Terraform',
      'CI/CD and observability',
      'Resilience, backup and recovery',
      'Cloud cost',
    ],
    deliverables: [
      'Architecture assessment',
      'Prioritized risk findings',
      'Cost optimization opportunities',
      'Implementation roadmap',
      'Review call',
    ],
    model: 'Fixed-scope engagement',
  },
  {
    title: 'Kubernetes Production Readiness Review',
    fit: 'For teams preparing EKS or GKE workloads for dependable production operation.',
    focus: [
      'Workloads and autoscaling',
      'Resources, probes and disruption',
      'Networking and ingress',
      'Security and secrets',
      'Observability and GitOps',
      'Disaster recovery readiness',
    ],
    deliverables: [
      'Readiness assessment',
      'Operational risk register',
      'Prioritized remediation plan',
      'Review call',
    ],
    model: 'Fixed-scope engagement',
  },
  {
    title: 'Terraform / IaC Architecture',
    fit: 'For teams whose infrastructure code has become difficult to change safely.',
    focus: [
      'Repository and module design',
      'Terragrunt and environment separation',
      'State and workflow boundaries',
      'CI validation and security',
      'Drift and maintainability',
    ],
    deliverables: [
      'Architecture recommendation',
      'Repository design',
      'Migration sequence',
      'Implementation guidance',
    ],
    model: 'Contact for scope',
  },
  {
    title: 'Cloud Migration',
    fit: 'For teams moving providers, regions or infrastructure foundations with controlled risk.',
    focus: [
      'Assessment and target architecture',
      'Terraform implementation',
      'Staged migration planning',
      'Observability and validation',
      'Rollback and cost optimization',
    ],
    deliverables: [
      'Migration plan',
      'Risk and dependency map',
      'IaC delivery support',
      'Cutover and validation plan',
    ],
    model: 'Project engagement',
    proof:
      'Relevant experience: zero-downtime migration with approximately 30% cost reduction.',
  },
  {
    title: 'Cloud Cost Optimization / FinOps',
    fit: 'For teams that need practical savings without compromising reliability.',
    focus: [
      'Utilization and waste',
      'Non-production environments',
      'Scaling and resource scheduling',
      'Architecture efficiency',
      'Cost visibility and automation',
    ],
    deliverables: [
      'Cost opportunity assessment',
      'Prioritized recommendations',
      'Automation plan',
      'Implementation support',
    ],
    model: 'Fixed-scope or project engagement',
    proof:
      'Relevant experience: approximately 15% cost reduction through AWS automation.',
  },
  {
    title: 'DevOps / Platform Engineering Advisory',
    fit: 'For engineering teams that need ongoing senior infrastructure support.',
    focus: [
      'Architecture reviews',
      'CI/CD and GitOps',
      'Kubernetes and Terraform',
      'Incident prevention',
      'Infrastructure roadmap',
      'Technical mentoring',
    ],
    deliverables: [
      'Regular advisory sessions',
      'Decision reviews',
      'Roadmap support',
      'Targeted implementation guidance',
    ],
    model: 'Suitable for a monthly retainer',
  },
];
---

<BaseLayout
  title="Cloud Infrastructure & DevOps Services"
  description="Fixed-scope infrastructure reviews, Kubernetes readiness, Terraform architecture, cloud migration, FinOps and platform engineering advisory."
>
  <header class="section border-b border-line">
    <div class="shell">
      <p class="eyebrow">Consulting services</p><h1 class="page-title mt-4">
        Senior infrastructure help for decisions that matter.
      </h1><p class="lede mt-6">
        Start with a focused review, continue into implementation when useful,
        and keep the engagement proportional to the problem.
      </p>
    </div>
  </header>
  <section class="section">
    <div class="shell grid gap-6">
      {
        services.map((service) => (
          <article class="card grid gap-8 lg:grid-cols-[.9fr_1.1fr]">
            <div>
              <p class="eyebrow">Consulting engagement</p>
              <h2 class="mt-4 text-2xl font-semibold tracking-[-.035em] md:text-3xl">
                {service.title}
              </h2>
              <p class="mt-4 text-muted">{service.fit}</p>
              {service.proof && (
                <p class="mt-5 rounded border-l-2 border-accent bg-[#f3f7f5] p-4 text-sm font-semibold">
                  {service.proof}
                </p>
              )}
              <p class="mt-6 font-mono text-xs font-bold uppercase tracking-wider text-accent-dark">
                {service.model}
              </p>
            </div>
            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <>
                  <h3 class="font-semibold">Review focus</h3>
                  <ul class="mt-3 space-y-2 text-sm text-muted">
                    {service.focus.map((item) => (
                      <li>— {item}</li>
                    ))}
                  </ul>
                </>
              </div>
              <div>
                <>
                  <h3 class="font-semibold">Potential deliverables</h3>
                  <ul class="mt-3 space-y-2 text-sm text-muted">
                    {service.deliverables.map((item) => (
                      <li>— {item}</li>
                    ))}
                  </ul>
                </>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
  <CTA
    title="Not sure which engagement fits?"
    copy="Describe the infrastructure problem, constraints and timeline. I’ll suggest a focused starting point."
  />
</BaseLayout>
