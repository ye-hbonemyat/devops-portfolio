---
import { navigation, site } from '../config/site';
const currentPath = Astro.url.pathname;
---

<header class="border-b border-line bg-paper/95">
  <div
    class="shell flex min-h-18 flex-wrap items-center justify-between gap-4 py-3"
  >
    <a
      class="group flex items-center gap-3 no-underline"
      href="/"
      aria-label={`${site.name}, home`}
    >
      <span
        class="grid size-9 place-items-center rounded-sm bg-ink font-mono text-xs font-bold text-white"
        >YH</span
      >
      <span class="font-semibold tracking-[-.02em]">{site.name}</span>
    </a>
    <nav aria-label="Main navigation">
      <ul
        class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium"
      >
        {
          navigation.map((item) => (
            <li>
              <a
                class:list={[
                  'no-underline hover:text-accent-dark',
                  {
                    'text-accent-dark underline': currentPath.startsWith(
                      item.href,
                    ),
                  },
                ]}
                href={item.href}
                aria-current={
                  currentPath.startsWith(item.href) ? 'page' : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
