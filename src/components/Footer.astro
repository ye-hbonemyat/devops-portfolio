---
import { navigation, site } from '../config/site';
---

<footer class="border-t border-line bg-white py-10">
  <div class="shell grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="font-semibold">{site.name}</p>
      <p class="mt-1 max-w-xl text-sm text-muted">
        {site.title} · {site.location}
      </p>
      <a
        class="mt-3 inline-block text-sm font-semibold text-accent-dark"
        href={`mailto:${site.email}`}>{site.email}</a
      >
    </div>
    <nav aria-label="Footer navigation">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
        {
          navigation.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="shell mt-8 border-t border-line pt-5 text-xs text-muted">
    © {new Date().getFullYear()}
    {site.name}. Built as a fast, static site.
  </div>
</footer>
