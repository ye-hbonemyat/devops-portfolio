---
interface Props {
  steps: string[];
  label?: string;
}
const { steps, label = 'Engineering workflow' } = Astro.props;
---

<figure
  class="mt-8 rounded-md border border-line bg-[#f3f7f5] p-5"
  aria-label={label}
>
  <figcaption
    class="mb-4 font-mono text-xs font-bold uppercase tracking-[.12em] text-muted"
  >
    {label}
  </figcaption>
  <ol class="grid gap-2 sm:grid-flow-col sm:auto-cols-fr sm:items-center">
    {
      steps.map((step, index) => (
        <li class="flex items-center gap-2">
          <span class="grid min-h-10 flex-1 place-items-center rounded border border-line bg-white px-3 text-center text-sm font-semibold">
            {step}
          </span>
          {index < steps.length - 1 && (
            <span class="rotate-90 text-accent sm:rotate-0" aria-hidden="true">
              →
            </span>
          )}
        </li>
      ))
    }
  </ol>
</figure>
